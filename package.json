    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run build && playwright test",
    "check": "npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "8.2.2"
  }
