{
  "name": "get-started-custom-frontend-module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A complete vanilla TypeScript frontend sample for a Cogover custom module.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
